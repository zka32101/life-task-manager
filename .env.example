# LifeTask Manager 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください

# Firebase（google-services.json / GoogleService-Info.plist からも設定）
FIREBASE_PROJECT_ID=your-firebase-project-id

# RevenueCat 課金
REVENUECAT_API_KEY_ANDROID=your_revenuecat_android_key
REVENUECAT_API_KEY_IOS=your_revenuecat_ios_key

# Sentry エラートラッキング
SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxxxx

# Anthropic Claude API（書類カメラの自動抽出・AI相談機能）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 環境
ENVIRONMENT=development
# ENVIRONMENT=production

# SendGrid（Cloud Functions 側で設定）
# SENDGRID_API_KEY=SG.xxxxx （Firebase Secrets で管理）
