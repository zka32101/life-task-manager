# ===================================
# SendGrid Email Configuration
# ===================================
# SendGrid Dashboard から API キーを取得：
# https://app.sendgrid.com/settings/api_keys
#
# 権限: Full Access (Mail Send, Templates, Contacts)
# 形式: SG.xxxxxxxxx
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ===================================
# Firebase Configuration
# ===================================
# Firebase Console から取得：
# Project Settings → General → プロジェクト情報
#
# 例: lifetask-manager-prod
FIREBASE_PROJECT_ID=lifetask-manager-xxxx

# Firebase API Key (Web API Key)
# 例: AIzaSyD5nxxxxxxxxxxxxxx
FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================
# Application Settings
# ===================================
# アプリケーション管理者のメール
ADMIN_EMAIL=admin@petitworks.com

# アプリケーション名
APP_NAME=LifeTask Manager

# 環境区分: development / staging / production
ENVIRONMENT=development

# ===================================
# Optional: Stripe Integration (Future)
# ===================================
# Stripe Secret Key (決済統合時)
# 形式: sk_live_xxxxx or sk_test_xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx

# ===================================
# Optional: Sentry Integration
# ===================================
# Sentry DSN (エラートラッキング)
# 形式: https://xxxx@xxxx.ingest.sentry.io/xxxxx
# SENTRY_DSN=https://key@project.ingest.sentry.io/12345
